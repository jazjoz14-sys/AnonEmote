# Copy this file to backend/.env and fill in your values.

PORT=3005

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API → service_role key (backend only, keep secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Google Perspective API ────────────────────────────────────────────────────
# Request access + create a key: https://developers.perspectiveapi.com/s/docs-get-started
# Leave blank to fall back to the local English keyword list.
PERSPECTIVE_API_KEY=your-perspective-api-key

# ── Admin console ─────────────────────────────────────────────────────────────
# Password for the admin console at /#admin. Use a strong value in production.
ADMIN_PASSWORD=change-me

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
