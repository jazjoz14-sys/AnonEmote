# Copy this file to backend/.env and fill in your values.

PORT=3005

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API → service_role key (backend only, keep secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Google Perspective API ────────────────────────────────────────────────────
# Request access + create a key: https://developers.perspectiveapi.com/s/docs-get-started
# Leave blank to fall back to the local English keyword list.
PERSPECTIVE_API_KEY=your-perspective-api-key

# ── Report integrity ──────────────────────────────────────────────────────────
# HMAC secret for the per-post reporter hash used to dedupe reports across
# sessions without storing IPs. Any long random string. Falls back to the
# service key if unset. Changing it resets existing dedupe state.
REPORT_HASH_SECRET=generate-a-long-random-string

# ── Admin console ─────────────────────────────────────────────────────────────
# Password for the admin console at /#admin. Use a strong value in production.
ADMIN_PASSWORD=change-me

# Kill switch. Set to "true" ONLY when you need to moderate. Leave absent or
# "false" on public deployments so the admin surface is completely unreachable
# and cannot be brute-forced even if the password is weak.
ADMIN_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
