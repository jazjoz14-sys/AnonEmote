# Copy to frontend/.env and fill in your values.
# Anything prefixed VITE_ is bundled into the browser build — never put a
# service role key or the admin password here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API base URL.
# Local dev goes through the Vite proxy (see vite.config.js), so this is only
# used if you call the API directly. In production set it to your deployed
# backend URL, e.g. https://anonemote-api.onrender.com
VITE_API_URL=http://localhost:3005
